# ── Aayesha Fashion storefront (Vercel) ─────────────────────────────────
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets here.
# Full explanation of every key: docs/ENVIRONMENT_KEYS.md

# REQUIRED. Deployed Express API (include /api).
NEXT_PUBLIC_API_BASE_URL=https://aayesha-fashion-backend.onrender.com/api

# Local dev only: where the Next.js /api rewrite proxies to (default http://localhost:4000).
BACKEND_URL=http://localhost:4000

# Recommended. Canonical site URL for product SEO/JSON-LD (default https://aayeshafashion.in).
NEXT_PUBLIC_SITE_URL=https://aayeshafashion.in

# Payments UI switches (both default to off).
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENT=false
NEXT_PUBLIC_ENABLE_COD=false

# Public address of the live store (no trailing slash) — canonical / sitemap / Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://aayeshafashion.in

# Search engines are blocked until this is "true". Set it ONLY on the live production deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional analytics (loaded only after the visitor consents).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional search-engine site verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional social profile URLs (footer icons appear once set).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TWITTER_URL=
